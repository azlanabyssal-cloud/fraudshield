{
  "name": "fraudshield",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "data:add": "node data_ops/add_message.js",
    "data:template": "node data_ops/generate_template.js",
    "data:validate": "node data_ops/validate_csv.js data_ops/golden_holdout.csv --report",
    "data:final": "node data_ops/validate_csv.js data_ops/golden_holdout.csv --report --final",
    "mlops:gate": "node mlops/run.js --data data_ops/golden_holdout.csv --stage=s0",
    "model:lineage": "node mlops/lineage.js",
    "model:lineage:check": "node mlops/lineage.js --check",
    "model:reproduce": "node mlops/lineage.js --reproduce",
    "mlops:gate:strict": "node mlops/run.js --data data_ops/golden_holdout.csv --stage=s0 --strict",
    "data:s0": "node data_ops/validate_csv.js data_ops/golden_holdout.csv --report --stage=s0",
    "site:sync": "node scripts/sync_site.js",
    "site:check": "node scripts/sync_site.js --check",
    "site:numbers": "node scripts/scan_numbers.js",
    "motion:build": "node scripts/build_motion.js",
    "motion:check": "node scripts/build_motion.js --check",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run site:check && npm run motion:check && npm run model:lineage:check && npm test",
    "field:analyze": "node field/analyze.js",
    "bench:ocr": "node scripts/browser/ocr.js",
    "bench:speech": "node scripts/browser/speech.js",
    "audit:pages": "node scripts/browser/pages.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  }
}
